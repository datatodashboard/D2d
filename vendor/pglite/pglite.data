                 #     (America/Anchorage)
                 #     (America/Juneau)
                 #     (America/Nome)
                 #     (America/Yakutat)
AKST   -32400    # Alaska Standard Time
                 #     (America/Anchorage)
                 #     (America/Juneau)
                 #     (America/Nome)
